{
    "name": "PlumaGram",
    "short_name": "PlumaGram",
    "id": "/",
    "start_url": "./",
    "scope": "./",
    "description": "PlumaGram — unofficial Telegram client.",
    "icons": [
        {
            "src": "assets/img/android-chrome-36x36.png?v=pluma1",
            "sizes": "36x36",
            "type": "image/png"
        },
        {
            "src": "assets/img/android-chrome-48x48.png?v=pluma1",
            "sizes": "48x48",
            "type": "image/png"
        },
        {
            "src": "assets/img/android-chrome-72x72.png?v=pluma1",
            "sizes": "72x72",
            "type": "image/png"
        },
        {
            "src": "assets/img/android-chrome-96x96.png?v=pluma1",
            "sizes": "96x96",
            "type": "image/png"
        },
        {
            "src": "assets/img/android-chrome-144x144.png?v=pluma1",
            "sizes": "144x144",
            "type": "image/png"
        },
        {
            "src": "assets/img/android-chrome-192x192.png?v=pluma1",
            "sizes": "192x192",
            "type": "image/png"
        },
        {
            "src": "assets/img/android-chrome-256x256.png?v=pluma1",
            "sizes": "256x256",
            "type": "image/png"
        },
        {
            "src": "assets/img/android-chrome-384x384.png?v=pluma1",
            "sizes": "384x384",
            "type": "image/png"
        },
        {
            "src": "assets/img/android-chrome-512x512.png?v=pluma1",
            "sizes": "512x512",
            "type": "image/png"
        }
    ],
    "share_target": {
        "action": "./share/",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "files",
                    "accept": "*/*"
                }
            ]
        }
    },
    "theme_color": "#fffffe",
    "background_color": "#ffffff",
    "display": "standalone"
}